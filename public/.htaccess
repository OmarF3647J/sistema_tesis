✅ Ruta correcta:

../sistema/vendor/autoload.php

Archivo final:

<?php

use Illuminate\Http\Request;

define('LARAVEL_START', microtime(true));

if (file_exists($maintenance = __DIR__.'/../sistema/storage/framework/maintenance.php')) {
    require $maintenance;
}

